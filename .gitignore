# The Firebase client configuration the app ships is the tracked file at
# TrainyIOS/Trainy/GoogleService-Info.plist (the archive audit requires the
# shipped copy to match it). A second copy at the repository root is
# unreferenced, so keep it from being re-added.
/GoogleService-Info.plist

